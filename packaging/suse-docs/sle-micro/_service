<!--
  The source tarballs of suse-docs-mcp-sle-micro, one per version:
  SUSE/doc-modular at the spec's revisions, without images, translations
  and templates, as doc-modular-SHORTREV.tar.xz (the same as
  tools/suse-docs/source-tarball makes). To update: change a revision
  here and rev, shortrev and revdate in the spec, then osc service
  manualrun.
-->
<services>
  <service name="tar_scm" mode="manual">
    <param name="scm">git</param>
    <param name="url">https://github.com/SUSE/doc-modular.git</param>
    <param name="revision">7440233ef92838854c8966b87896efccdcee1c58</param>
    <param name="filename">doc-modular</param>
    <param name="version">7440233</param>
    <param name="exclude">images</param>
    <param name="exclude">l10n</param>
    <param name="exclude">templates</param>
    <param name="exclude">SmartDocs-Cheatsheet.*</param>
  </service>
  <service name="tar_scm" mode="manual">
    <param name="scm">git</param>
    <param name="url">https://github.com/SUSE/doc-modular.git</param>
    <param name="revision">32a0b5d6b5d5ecf57941f3882ae74cfd8c99414f</param>
    <param name="filename">doc-modular</param>
    <param name="version">32a0b5d</param>
    <param name="exclude">images</param>
    <param name="exclude">l10n</param>
    <param name="exclude">templates</param>
    <param name="exclude">SmartDocs-Cheatsheet.*</param>
  </service>
  <service name="tar_scm" mode="manual">
    <param name="scm">git</param>
    <param name="url">https://github.com/SUSE/doc-modular.git</param>
    <param name="revision">a9f708401da072b024e66994c8f15d91250b836e</param>
    <param name="filename">doc-modular</param>
    <param name="version">a9f7084</param>
    <param name="exclude">images</param>
    <param name="exclude">l10n</param>
    <param name="exclude">templates</param>
    <param name="exclude">SmartDocs-Cheatsheet.*</param>
  </service>
  <service name="recompress" mode="manual">
    <param name="file">*.tar</param>
    <param name="compression">xz</param>
  </service>
</services>
