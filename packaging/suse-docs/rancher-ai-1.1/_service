<!--
  The source tarball of suse-docs-mcp-rancher-ai-1.1: rancher/rancher-ai-product-docs at
  the spec's revision with its submodule product-docs-common (the site's
  attributes), without images, translations and other versions, as
  rancher-ai-product-docs-SHORTREV.tar.xz. tools/suse-docs/source-tarball-antora
  makes the tree the conversion reads, which is what CI builds from;
  this service is written to make the same and has not been run. To
  update: change the revision here and rev, shortrev and revdate in the
  spec, then osc service manualrun.
-->
<services>
  <service name="tar_scm" mode="manual">
    <param name="scm">git</param>
    <param name="url">https://github.com/rancher/rancher-ai-product-docs.git</param>
    <param name="revision">6c872577a6db7b3da64af6d15809f4c1b4651231</param>
    <param name="filename">rancher-ai-product-docs</param>
    <param name="version">6c87257</param>
    <param name="submodules">enable</param>
    <param name="exclude">dsc-style-bundle</param>
    <param name="exclude">bin</param>
    <param name="exclude">*/modules/de</param>
    <param name="exclude">*/modules/es</param>
    <param name="exclude">*/modules/fr</param>
    <param name="exclude">*/modules/ja</param>
    <param name="exclude">*/modules/pt</param>
    <param name="exclude">*/modules/zh</param>
    <param name="exclude">*/modules/en/images</param>
    <param name="exclude">*/modules/en/attachments</param>
  </service>
  <service name="recompress" mode="manual">
    <param name="file">*.tar</param>
    <param name="compression">xz</param>
  </service>
</services>
