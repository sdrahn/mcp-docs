<!--
  The source tarball of suse-docs-mcp-sles-sap-16.1, the same as
  suse-docs-mcp-sles-16.1's: SUSE/doc-modular at the spec's revision,
  without images, translations and templates, as
  doc-modular-SHORTREV.tar.xz (the same as tools/suse-docs/source-tarball
  makes). To update: change the revision here and rev, shortrev and
  revdate in the spec, then osc service manualrun.
-->
<services>
  <service name="tar_scm" mode="manual">
    <param name="scm">git</param>
    <param name="url">https://github.com/SUSE/doc-modular.git</param>
    <param name="revision">1a9929880092d38b658b5b590578206bb6d4178b</param>
    <param name="filename">doc-modular</param>
    <param name="version">1a99298</param>
    <param name="exclude">images</param>
    <param name="exclude">l10n</param>
    <param name="exclude">templates</param>
    <param name="exclude">SmartDocs-Cheatsheet.*</param>
  </service>
  <service name="recompress" mode="manual">
    <param name="file">*.tar</param>
    <param name="compression">xz</param>
  </service>
</services>
